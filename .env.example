# ---------------------------------------------------------------------------
# Analisador Inteligente de Editais — variáveis de ambiente
# Copie para `.env.local` (ou `.env`) e preencha os valores necessários.
# NUNCA comite o arquivo .env.local.
# ---------------------------------------------------------------------------

# === IA (obrigatório para a análise com IA) ================================
# Opção gratuita (recomendada): chave do Google AI Studio (https://aistudio.google.com/apikey).
# Quando presente, tem prioridade sobre a DeepSeek. Modelo padrão: gemini-2.5-flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODELOS_RESERVA=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Limites da demonstração pública (análises NOVAS com IA; resultados em cache não contam).
AI_LIMITE_POR_IP_HORA=4
AI_LIMITE_DIARIO=40

# Chave da API DeepSeek. Sem ela a aplicação roda no modo de demonstração
# local (extração determinística por padrões), claramente sinalizado na tela.
DEEPSEEK_API_KEY=

# Endpoint compatível com a API OpenAI (padrão: DeepSeek oficial).
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Modelo usado na leitura/análise do edital.
DEEPSEEK_MODEL=deepseek-chat

# Modelo usado na síntese final de documentos longos (padrão: igual ao acima).
DEEPSEEK_SYNTHESIS_MODEL=deepseek-chat

# Temperatura: 0 reduz variação e alucinação (recomendado para extração).
AI_TEMPERATURE=0

# Limite de tokens da resposta do modelo. O schema completo de uma análise
# (dez seções, com trechos de origem) costuma exigir de 12K a 15K tokens em um
# edital de 8 páginas: com 8192 a resposta era cortada no meio e o JSON não
# fechava.
AI_MAX_OUTPUT_TOKENS=32768

# Teto para o qual o limite de saída sobe automaticamente quando o provedor
# corta a resposta (finish_reason=length), e quantas vezes isso pode acontecer.
AI_MAX_OUTPUT_TOKENS_CEILING=65536
AI_MAX_OUTPUT_ESCALATIONS=1

# Tempo máximo por chamada de IA (ms) e número de retentativas.
AI_TIMEOUT_MS=180000
AI_MAX_RETRIES=2

# Teto de tempo da análise completa (ms). Protege contra uma sequência de
# blocos com timeout consumindo tokens por horas. Use 0 para desativar.
AI_MAX_ANALYSIS_MS=900000

# Janela de contexto do modelo (tokens) e fração reservada ao prompt.
# Usados para dimensionar o prompt da síntese final em documentos longos.
AI_CONTEXT_WINDOW_TOKENS=64000
AI_PROMPT_BUDGET_RATIO=0.7

# Preços de referência (USD por 1M tokens) — usados apenas para estimar custo.
AI_PRICE_INPUT_PER_M=0.27
AI_PRICE_OUTPUT_PER_M=1.1

# === Upload e processamento do PDF =========================================
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=600

# Mínimo de caracteres extraídos para considerar que o PDF tem camada de texto.
MIN_CHARS_FOR_ANALYSIS=400

# === Estratégia para documentos longos =====================================
# Até este tamanho (caracteres) o edital é analisado em uma única chamada.
SINGLE_CALL_MAX_CHARS=60000
# Tamanho alvo de cada bloco no modo mapa-redução.
CHUNK_CHARS=14000
# Sobreposição entre blocos (contexto nas fronteiras).
CHUNK_OVERLAP_CHARS=800
# Máximo de blocos e paralelismo das chamadas.
# ATENÇÃO: se o documento gerar mais blocos que este limite, as páginas
# excedentes NÃO serão analisadas — o relatório avisa isso explicitamente.
# Documentos muito grandes exigem aumentar este valor (e o custo de tokens).
MAX_CHUNKS=80
CHUNK_CONCURRENCY=3
# Recorte de cada página no índice enviado na síntese.
PAGE_INDEX_PREVIEW_CHARS=110

# === Geração do relatório em PDF ===========================================
# Caminho explícito para o navegador headless. Deixe vazio para autodetectar
# Microsoft Edge / Google Chrome instalados no sistema.
REPORT_BROWSER_PATH=
# Tempo máximo da geração do PDF (ms).
REPORT_TIMEOUT_MS=90000
# Defina como true para desativar o download do PDF (a impressão continua).
REPORT_PDF_DISABLED=false

# === Diagnóstico ===========================================================
# Por padrão os detalhes técnicos dos erros ficam apenas no log do servidor.
# Defina como true em desenvolvimento para recebê-los também na interface.
EXPOSE_ERROR_DETAILS=false
